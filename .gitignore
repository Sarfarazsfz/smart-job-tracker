# Root .gitignore

# Environment variables (CRITICAL - contains API keys)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
*.log

# IDE
.vscode/
.idea/

# OS specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Package lock files are intentionally tracked
# package-lock.json is required for reproducible npm ci builds.
# Do NOT ignore package-lock.json.

# Artifacts (local development)
.gemini/
brain/